{
  "expo": {
    "name": "FitPulse",
    "slug": "fitpulse-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitpulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitpulse.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fitpulse.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-sensors",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitPulse to access your photos for food analysis.",
          "cameraPermission": "Allow FitPulse to take food photos for calorie tracking."
        }
      ],
      "expo-camera"
    ]
  }
}
